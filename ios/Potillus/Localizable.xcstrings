    "Without a body weight, no blood-alcohol estimate is shown." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez tělesné hmotnosti se odhad alkoholu v krvi nezobrazuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden en kropsvægt vises der intet promilleestimat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Körpergewicht wird keine Blutalkohol-Schätzung angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς σωματικό βάρος δεν εμφανίζεται εκτίμηση του αλκοόλ στο αίμα."
