        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier JSON contenant vos boissons, votre journal et vos réglages — y compris votre poids corporel. Il ne quitte jamais cet appareil, sauf si vous l’envoyez quelque part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file JSON con le tue bevande, il tuo registro e le tue impostazioni — incluso il tuo peso corporeo. Non lascia mai questo dispositivo, a meno che non sia tu a inviarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飲み物、記録、設定（体重を含む）を含む JSON ファイルです。自分で送信しない限り、この端末から外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음료, 기록, 설정(체중 포함)이 담긴 JSON 파일입니다. 직접 보내지 않는 한 이 기기 밖으로 나가지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En JSON-fil med drinkene dine, loggen din og innstillingene dine — inkludert kroppsvekten din. Den forlater aldri denne enheten, med mindre du selv sender den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een JSON-bestand met je drankjes, je logboek en je instellingen — inclusief je lichaamsgewicht. Het verlaat dit apparaat nooit, tenzij je het zelf verstuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik JSON zawierający Twoje napoje, dziennik i ustawienia — łącznie z masą ciała. Nigdy nie opuszcza tego urządzenia, chyba że sam go wyślesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ficheiro JSON com as suas bebidas, o seu registo e as suas definições — incluindo o seu peso corporal. Nunca sai deste dispositivo, a menos que o envie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo JSON com suas bebidas, seu registro e suas configurações — incluindo seu peso corporal. Ele nunca sai deste dispositivo, a menos que você o envie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fișier JSON cu băuturile tale, jurnalul tău și setările tale — inclusiv greutatea ta corporală. Nu părăsește niciodată acest dispozitiv decât dacă îl trimiți tu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл JSON с вашими напитками, журналом и настройками — включая массу тела. Он никогда не покидает это устройство, если вы сами его не отправите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En JSON-fil med dina drycker, din logg och dina inställningar — inklusive din kroppsvikt. Den lämnar aldrig den här enheten om du inte själv skickar den."
          }
        },
        "uk" : {
          "stringUnit" : {
