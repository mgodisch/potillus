            "state" : "translated",
            "value" : "Without a body weight, no blood-alcohol estimate is shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin un peso corporal no se muestra ninguna estimación del alcohol en sangre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans poids corporel, aucune estimation de l’alcoolémie n’est affichée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un peso corporeo non viene mostrata alcuna stima del tasso alcolemico."
          }
        },
        "ja" : {
