# =============================================================================
# Fastfile -- fastlane lanes for Libellus Potionis
# =============================================================================
#
# This defines the lanes for BOTH platforms, in two blocks that mirror each
# other. `testing` and `production` name the same two audiences on both sides:
# testing is the tester-facing channel (Play open testing, TestFlight),
# production the store-facing one (Play production track, App Store listing).
# Android (`platform :android`, the default): `screenshots` captures the in-app
# Play-Store screenshots via screengrab (configuration in Screengrabfile),
# `testing` / `production` upload an already-built, signed App Bundle plus the
# store listing to Google Play. iOS (`platform :ios`): `screenshots` captures the
# App Store screenshots via snapshot (Snapfile), `testing` uploads an
# already-built, signed .ipa to TestFlight, `production` uploads it plus the App
# Store listing, and `preflight` checks the App Store Connect credentials without
# uploading anything. NO lane builds anything -- see the per-lane `desc` text and
# the platform-level comment before the iOS block for the details.
#
# NO lane submits anything for review either. A Play upload is a draft release, a
# TestFlight upload reaches no tester group, and an App Store upload stops at
# "Prepare for Submission". Handing a build to Google, to Apple's Beta App Review
# or to App Store review is a deliberate act in the respective console.
#
# The screenshot lanes are intended to be invoked by the `make screenshots-android`
# and `make screenshots-ios` targets (the top-level Makefile), which wrap them with
# Demo Mode / status-bar set-up and tear-down, device-date pinning and PDF-report
# rendering (screenshots 07/08).
#
# Running a screenshot lane on its own is possible (`bundle exec fastlane
# screenshots`), but then the status bar is NOT cleaned and the PDF pages are NOT
# produced -- use the `make` targets for the complete, store-ready asset set.
# =============================================================================

# fastlane regenerates fastlane/README.md after every run, from the `desc` lines
# below. That file is not kept: it restated a fraction of what those `desc` blocks
# already say, drifted out of date between runs, and needed an exemption from the
# GPL-header gate. The lanes are documented by the `desc` blocks below and by
# docs/RELEASE-IOS.md; `bundle exec fastlane lanes` lists them on demand, and
# `bundle exec fastlane docs` still writes the file for anyone who wants it.
skip_docs

default_platform(:android)

platform :android do
  desc 'Capture the in-app Play-Store screenshots (all store locales) via screengrab.'
  desc 'Prefer `make screenshots-android`, which also cleans the status bar (Demo Mode)'
  desc 'and renders the PDF report pages as screenshots 07/08.'
  lane :screenshots do
    # `capture_android_screenshots` is the modern alias of the `screengrab`
    # action. It reads Screengrabfile, installs the APKs, and for each locale
    # runs the screenshot suite and pulls the PNGs into the fastlane metadata
    # tree. Demo Mode and PDF rendering are handled by the Makefile around this.
    capture_android_screenshots
  end

  # ── upload_release ── the single upload_to_play_store call shared by the public
  # `testing` and `production` lanes below. Only the track differs between them, so
  # the rest lives here ONCE (the same drift-avoidance principle the rest of the
  # tooling follows). Private: not listed by `fastlane lanes` and not callable from
  # the CLI -- go through `testing` / `production`.
  #
  # `upload_to_play_store` is the modern alias of the `supply` action. It reads the
  # package_name and the service-account key from the Appfile, uploads the AAB
  # produced by `./gradlew bundleRelease`, and syncs the listing texts, changelogs
  # and images from fastlane/metadata/android/ -- the SAME tree F-Droid reads, so
  # the two stores never diverge.
  private_lane :upload_release do |options|
    upload_to_play_store(
      # AAB (not APK): Google Play requires the App Bundle format for new apps.
      # The path is supplied by the caller so `make push-playstore-testing` and
      # `make push-playstore-production` can upload the STAGED bundle
      # (releases/<applicationId>_<versionCode>.aab) they have verified, rather than
      # the raw Gradle output. Falls back to the Gradle path when the lane is run
      # directly without an aab: option.
      aab: options[:aab] || 'android/app/build/outputs/bundle/release/app-release.aab',

      # The track is chosen by the calling lane.
      track: options[:track],

      # EVERY upload is a DRAFT release, on every track. Google Play sends a
      # release to review when it is rolled out, so a draft is the state in which
      # the maintainer can open the Play Console, look at what was uploaded, and
      # decide. The value is hard-coded rather than a lane option: a `status:` the
      # caller could pass would be an ungated path to `completed`, which is what
      # this exists to prevent. Rolling out happens in the Play Console.
      release_status: 'draft',

      # Dry-run switch. When true, supply VALIDATES the edit against the Play API
      # but changes nothing on Google Play (default false). Passed through from the
      # testing / production lanes; coerced with to_s so it behaves whether the
      # lane option arrives as a boolean or as a string CLI argument.
      validate_only: options[:validate_only].to_s == 'true',

      # We upload a bundle, never a bare APK, so disable the APK upload paths.
      skip_upload_apk: true,

      # OVERWRITE the store listing from fastlane/metadata/android/: every skip_*
      # is false, so the titles, descriptions, feature graphics, screenshots and
      # changelogs are all (re)uploaded, replacing what is live -- making the repo
      # the single source of truth for the listing on every track.
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc 'Upload the SIGNED release App Bundle to the OPEN-TESTING (beta) track as a'
  desc 'DRAFT release and OVERWRITE the store listing + release notes on Google Play'
  desc '(titles, short/full descriptions, feature graphics, screenshots and'
  desc 'changelogs from fastlane/metadata/android/). The draft waits in the Play'
  desc 'Console for you to review and roll out; rolling out is what sends it to'
  desc 'review. Build the bundle first with `make -C android bundle`; the Makefile'
  desc '`push-playstore-testing` target guards that prerequisite -- this lane does'
  desc 'NOT build it.'
  desc 'Options (all optional):'
  desc '  track:<name>   Play track (default: beta, the open-testing track). For'
  desc '                 production use the dedicated `production` lane below.'
  desc '  validate_only:<bool>  Dry run -- validate the upload against the Play API'
  desc '                 without changing anything on Google Play (default false).'
  desc 'Example:  bundle exec fastlane testing track:beta'
  lane :testing do |options|
    upload_release(
      track: options[:track] || 'beta',
      validate_only: options[:validate_only],
      aab: options[:aab],
    )
  end

  desc 'Upload the SIGNED release App Bundle to the PRODUCTION track as a DRAFT'
  desc 'release and OVERWRITE the store listing + release notes on Google Play. Same'
  desc 'build prerequisite as `testing` (this lane does NOT build the AAB). The'
  desc 'release waits in the Play Console for you to review and roll out; rolling'
  desc 'out is what sends it to review. NOTE: a new personal developer account'
  desc 'cannot publish to production until the closed-testing gate is cleared'
  desc '(12 testers / 14 days).'
  desc 'Options (all optional):'
  desc '  track:<name>   Play track (default: production).'
  desc '  validate_only:<bool>  Dry run -- validate the upload against the Play API'
  desc '                 without changing anything on Google Play (default false).'
  desc 'Example:  bundle exec fastlane production'
  lane :production do |options|
    upload_release(
      track: options[:track] || 'production',
      validate_only: options[:validate_only],
      aab: options[:aab],
    )
  end
end

# =============================================================================
# iOS platform -- App Store Connect lanes (mirror of the Android block above)
# =============================================================================
#
# These lanes manage the App Store listing the same way the Android lanes manage
# the Play listing: the repository is the single source of truth. The listing
# texts, keywords and release notes live in fastlane/metadata/ios/ and the store
# screenshots in fastlane/screenshots/ios/; both paths are handed to deliver
# EXPLICITLY (its defaults ignore the platform), and both are pushed verbatim on
# every upload, so the App Store and the Play Store never drift from what is
# committed here.
#
# AUTHENTICATION -- App Store Connect API key (.p8), the modern, 2FA-proof method.
#   `app_store_connect_api_key` reads three values and stores the resulting token
#   in fastlane's lane context, from where `deliver`/`snapshot` pick it up
#   automatically. All three are SECRETS injected via the environment (never
#   committed); fastlane's own default env names are used, so no wiring is needed:
#     APP_STORE_CONNECT_API_KEY_KEY_ID       -- the key's ID (e.g. D383SF739)
#     APP_STORE_CONNECT_API_KEY_ISSUER_ID    -- the team's issuer ID (a UUID)
#     APP_STORE_CONNECT_API_KEY_KEY_FILEPATH -- path to the downloaded AuthKey_*.p8
#   Create the key in App Store Connect → Users and Access → Integrations → Keys.
#   The .p8 is git-ignored (.gitignore → /fastlane/AuthKey_*.p8); it downloads
#   ONCE and cannot be re-downloaded, so store it safely.
#
# BUILDING -- like the Android lanes, these lanes do NOT build the app. Produce a
#   signed .ipa on the Mac first with `make release-ios` (which archives, exports
#   and stages it into releases/; Xcode's Archive → Distribute flow works too),
#   then run an upload lane. Every upload lane takes the staged .ipa as `ipa:`
#   (mirroring how the Android lanes take `aab:`), defaulting to the raw build
#   output ios/build/Potillus.ipa when none is passed. Screenshots are produced by
#   the `screenshots` lane below.

platform :ios do
  desc 'Capture the App Store screenshots (all store locales) via snapshot.'
  desc 'Requires a UI-test scheme that drives the app through the six screens;'
  desc 'configuration lives in Snapfile. Prefer `make screenshots-ios`, which'
  desc 'pins the device date and renders the two PDF-report pages, mirroring the'
  desc 'Android `make screenshots-android` flow.'
  lane :screenshots do
    # `capture_ios_screenshots` is the modern alias of the `snapshot` action. It
    # reads Snapfile, builds the UI-test target, and runs it across every
    # simulator/locale pair, collecting the PNGs into the fastlane screenshots
    # tree. Status-bar cleanup and PDF rendering are handled around this by the
    # Makefile, exactly as on Android.
    capture_ios_screenshots
  end

  # ── preflight ── prove, BEFORE anything is uploaded, that the App Store Connect
  # API key in the environment actually authenticates AND that this app's record is
  # reachable with it. The Android counterpart of this guard lives in the Makefile
  # (the `push-playstore-*` targets run `fastlane run validate_play_store_json_key`),
# because
  # supply's key is a plain file path and fastlane's CLI takes it as a string. The
  # iOS credential cannot travel that way: `app_store_connect_api_key` returns a
  # HASH, and fastlane's `run` CLI supports only primitive types -- "Hashes are not
  # currently supported" (docs.fastlane.tools). So the check lives HERE, in Ruby,
  # where the hash is passed directly, and both `push-appstore-*` targets call this
# lane.
  #
  # `app_store_build_number` is a read-only App Store Connect query, which makes it
  # a cheap, side-effect-free way to exercise the whole path: the key file, the key
  # ID and issuer ID, the key's role, and the existence of the app record for the
  # Appfile's app_identifier. Two options keep it from failing on a healthy app:
  #   live: false            -- query the edit/TestFlight train, not the ready-for-
  #                             sale one, which does not exist until a first release
  #                             has actually gone live.
  #   initial_build_number:0 -- documented as "sets the build number to given value
  #                             if no build (upload) is in current train", i.e. a
  #                             brand-new app with no build yet answers 0 instead of
  #                             erroring. We do not use the number; reaching it IS
  #                             the check.
  desc 'Verify the App Store Connect API key authenticates and this app is reachable.'
  desc 'Read-only: queries the current build number and uploads nothing. Run by'
  desc 'both `make push-appstore-*` targets before the upload; useful on its own to'
  desc 'test credentials.'
  lane :preflight do
    api_key = app_store_connect_api_key

    build_number = app_store_build_number(
      api_key: api_key,
      live: false,
      initial_build_number: 0
    )

    UI.success("preflight: App Store Connect reachable; current build number: #{build_number}")
  end

  desc 'Upload the SIGNED .ipa to TestFlight, where it reaches NO tester group.'
  desc 'Unlike the `production` lane below, this pushes no listing metadata or'
  desc 'screenshots -- TestFlight does not use them. It also hands the build to'
  desc 'nobody: assigning it to the external group is a click in App Store Connect,'
  desc 'and that click is what submits it to Apple Beta App Review. The lane waits'
  desc 'for App Store Connect to finish processing, so it runs for several minutes'
  desc 'after the bytes are gone. Build the .ipa first with `make release-ios`;'
  desc 'the Makefile `push-appstore-testing` target guards that prerequisite and'
  desc 'passes the staged path -- this lane does NOT build it.'
  lane :testing do |options|
    # Authenticate with the App Store Connect API key. Capturing the return value
    # and passing it explicitly to upload_to_testflight is the documented pattern
    # for that action (the `production` lane below instead relies on the token that
    # the same call leaves in lane_context for deliver).
    api_key = app_store_connect_api_key

    upload_to_testflight(
      api_key: api_key,

      # The signed binary. Defaults to the raw build output, but normally the
      # caller passes the staged releases/ path that `make release-ios` prints --
      # the same `ipa:`/`aab:` option convention the Android lanes use.
      ipa: options[:ipa] || 'ios/build/Potillus.ipa',

      # NO external distribution. `distribute_external: true` would need `groups`,
      # would e-mail those testers, and -- the reason it is off -- would submit the
      # build to Apple Beta App Review as part of the upload
      # (docs.fastlane.tools/actions/upload_to_testflight). Review submission is
      # the maintainer's decision, taken in App Store Connect by adding the build
      # to the "Libellus Potionis External Testers" group. Without external
      # distribution there is no "what to test" note to set either; the group's
      # testers see the one entered beside that decision. The Beta App Review
      # contact and beta app description are curated once in App Store Connect
      # (see docs/RELEASE-IOS.md).
      distribute_external: false,

      # WAIT for processing rather than returning the moment the upload finishes.
      # Nothing here depends on a processed build, so this is purely for the
      # report: Apple rejects a malformed binary during processing, and waiting is
      # what turns that into a failed lane instead of an e-mail hours later.
      skip_waiting_for_build_processing: false
    )
  end

  # ── production ── the App Store half of the pair. `upload_to_app_store` is the
  # modern alias of the `deliver` action. It reads the app_identifier from the
  # Appfile, uploads the signed .ipa, and syncs the listing texts, keywords and
  # release notes from fastlane/metadata/ios/ -- the single source of truth for the
  # App Store listing.
  #
  # This call used to live in a private lane behind two public ones that differed
  # in submit_for_review alone. With review submission gone (see the note on
  # submit_for_review's absence below), there is one caller and the indirection is
  # spent, so the action sits here directly.
  desc 'Upload the SIGNED .ipa and OVERWRITE the App Store listing + release notes'
  desc '(names, subtitles, keywords, descriptions and screenshots from'
  desc 'fastlane/metadata/ios/) WITHOUT submitting for review. The build lands in'
  desc 'App Store Connect as "Prepare for Submission" for you to check; selecting'
  desc 'the build and submitting it happens there. Build the .ipa first with'
  desc '`make release-ios`; the Makefile `push-appstore-production` target guards'
  desc 'that prerequisite and passes the staged path -- this lane does NOT build it.'
  lane :production do |options|
    # Authenticate first; the token lands in lane_context for deliver to use.
    app_store_connect_api_key

    upload_to_app_store(
      # The signed app binary. Defaults to the raw build output, but the caller
      # normally passes the staged releases/ path from `make release-ios` as
      # `ipa:` -- mirroring how the Android lanes take `aab:`.
      ipa: options[:ipa] || 'ios/build/Potillus.ipa',

      # WHERE the listing lives. Both of these are REQUIRED, not decoration: this
      # repository serves two stores, so the trees are platform-qualified
      # (fastlane/metadata/ios beside fastlane/metadata/android, and likewise for
      # screenshots). deliver's defaults are NOT platform-aware -- they are
      # ./fastlane/metadata and ./fastlane/screenshots regardless of `platform`
      # (docs.fastlane.tools/actions/deliver). Pointed at those, deliver reads the
      # `android`/`ios` directories as LOCALE names, finds them in neither case on
      # its list of App Store languages, and aborts with "Unsupported directory
      # name(s) for screenshots/metadata". The paths are repo-root-relative because
      # a fastlane LANE runs from the project root (see the push-appstore-* targets
      # in the Makefile for the one place where that is not true).
      metadata_path: 'fastlane/metadata/ios',
      screenshots_path: 'fastlane/screenshots/ios',

      # Push them on every upload so the listing matches the repository -- every
      # skip_* below is false.
      skip_metadata: false,
      skip_screenshots: false,

      # precheck scans the listing for common rejection reasons before upload.
      run_precheck_before_submit: true,

      # NO submit_for_review. deliver defaults it to false, and the option is left
      # out rather than spelled out as false so that no caller can pass it. Two
      # consequences worth knowing: the version stays in "Prepare for Submission",
      # and deliver does not select a build for it -- selecting the build is part
      # of what submit_for_review does. So App Store Connect shows the listing this
      # lane wrote and a TestFlight build waiting to be picked; picking it and
      # submitting are the maintainer's two clicks.

      # Skip deliver's interactive confirmation of the generated HTML preview
      # report, so the lane runs unattended. It does NOT force anything onto the
      # listing beyond what the skip_* switches above already push.
      force: true,

      # precheck's in-app-purchase scan needs App Store Connect permissions this
      # app has no use for: it ships no in-app purchases. Turning the scan off
      # keeps precheck from failing on a category that cannot apply here.
      precheck_include_in_app_purchases: false
    )
  end
end
